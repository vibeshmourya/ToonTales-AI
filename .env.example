# =====================================================================
# ToonTales AI — Multi-Provider AI Story and Illustration Engine
# Copy this file to .env and insert your provider credentials.
# All keys entered here or in the Streamlit sidebar are protected
# and never exposed in URLs, story metadata, logs, or UI text.
# =====================================================================

# ---------------------------------------------------------------------
# Story Generation Providers & Models
# ---------------------------------------------------------------------

# Default Story Provider: 'gemini', 'openai', 'anthropic', or 'openrouter'
STORY_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-2.5-flash

# OpenAI (https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TEXT_MODEL=gpt-4o-mini

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_TEXT_MODEL=claude-3-5-sonnet-20241022

# OpenRouter (https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_TEXT_MODEL=meta-llama/llama-3.3-70b-instruct

# ---------------------------------------------------------------------
# Image Generation Providers & Models
# ---------------------------------------------------------------------

# Default Image Provider: 'gemini', 'openai', 'openrouter', or 'pollinations'
IMAGE_PROVIDER=gemini

# Google Gemini Image Models
# Models: imagen-3.0-generate-002 (Vertex AI / Imagen 3), gemini-2.5-flash-image (Developer API)
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

# OpenAI DALL-E (Models: dall-e-3, dall-e-2)
OPENAI_IMAGE_MODEL=dall-e-3

# OpenRouter Image Models (Dynamic discovery via /api/v1/images/models)
# Verified Models: recraft/recraft-v4.1-flash-v2:free, microsoft/mai-image-2.7-flash, black-forest-labs/flux.2-flex
OPENROUTER_IMAGE_MODEL=recraft/recraft-v4.1-flash-v2:free

# Pollinations AI (Explicit Selection Only; https://pollinations.ai / https://enter.pollinations.ai/keys)
# Models: flux, turbo, flux-realism, flux-anime, flux-3d
POLLINATIONS_IMAGE_MODEL=flux
# Optional: Bearer key for enter.pollinations.ai/keys. Leave blank to use public tier.
# POLLINATIONS_API_KEY=your_pollinations_api_key_here
