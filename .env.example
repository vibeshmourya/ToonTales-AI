# ToonTales AI - Environment Configuration
# Copy this file to .env and fill in your API credentials

# Google Gemini API Key (Get yours from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Text Model for Story and Scene Generation
# Recommended: gemini-2.5-flash or gemini-2.0-flash
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Image Generation Provider: 'pollinations' (Recommended - zero billing required) or 'gemini' (Gemini Developer API)
IMAGE_PROVIDER=pollinations

# Pollinations AI Settings
# Model options: flux (recommended, best cartoon quality), turbo, flux-realism, flux-anime, flux-3d
POLLINATIONS_IMAGE_MODEL=flux
# Optional: secret key from enter.pollinations.ai/keys (leave blank for zero-cost public tier)
# POLLINATIONS_API_KEY=your_optional_pollinations_key_here

# Google Gemini Image Model (Requires linked Google Cloud billing project; free-tier quota is 0)
# Supported models: gemini-2.5-flash-image, gemini-3.1-flash-image
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

